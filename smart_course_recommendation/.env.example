# YouTube Data API v3 Key (Required for live YouTube course retrieval)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=

# Google Gemini API Key (Optional - enables AI explanations, study plans, and Q&A advisor)
# Obtain from Google AI Studio
GEMINI_API_KEY=

# Optional Gemini Model Override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
